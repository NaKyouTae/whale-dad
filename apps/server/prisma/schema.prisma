// whale-dad — Prisma 스키마
// DB: 로컬 PostgreSQL(docker-compose) / 운영 Supabase
// 연결 URL 은 prisma.config.ts(CLI) / PrismaService(런타임) 에서 주입한다.
// 변경 후: pnpm db:migrate (dev) / pnpm db:deploy (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── 사용자 ──
// 계정(username) + 비밀번호로 로그인한다. username 이 곧 표시 이름이다.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// 로그인 계정 = 화면에 보이는 이름
  username     String   @unique
  /// scrypt 해시 (`scrypt$<salt>$<hash>`)
  passwordHash String   @map("password_hash")
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bossKills  BossChannel[] @relation("BossChannelLastKilledBy")
  bossChecks BossChannel[] @relation("BossChannelLastCheckedBy")

  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  ADMIN
  MEMBER
}

/// 보스 종류. 값은 packages/shared 의 `BossType` 과 같아야 한다.
enum BossType {
  YEODUMOK
  CHEONGU
}

// ── 보스 채널 ──
// 채널 목록 자체를 DB 로 관리해 게임 패치로 채널 수가 바뀌어도 수동 조정할 수 있게 한다.
// 출현 시각은 저장하지 않고 lastKilledAt + 보스별 젠 간격으로 계산한다.
// 채널 번호는 보스마다 따로 셈하므로 유니크 키는 (bossType, channel) 이다.
model BossChannel {
  id           String    @id @default(uuid()) @db.Uuid
  /// 어느 보스의 채널인지. 기존 행은 전부 여두목이라 기본값을 둔다
  bossType     BossType  @default(YEODUMOK) @map("boss_type")
  /// 게임 내 채널 번호 (기본 0 ~ 231)
  channel      Int
  /// 마지막 처치 시각. null 이면 아직 기록 없음
  lastKilledAt DateTime? @map("last_killed_at")
  /// 마지막으로 처치를 기록한 계정. 계정이 지워져도 타이머는 남긴다
  lastKilledById String? @map("last_killed_by_id") @db.Uuid
  lastKilledBy   User?   @relation("BossChannelLastKilledBy", fields: [lastKilledById], references: [id], onDelete: SetNull)
  /// 출현 시각이 지난 뒤 "가봤는데 없었다"고 확인한 시각. 처치를 새로 기록하면 지운다
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastCheckedById String?   @map("last_checked_by_id") @db.Uuid
  lastCheckedBy   User?     @relation("BossChannelLastCheckedBy", fields: [lastCheckedById], references: [id], onDelete: SetNull)
  memo         String?
  /// 목록에서 감출 채널은 false
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([bossType, channel])
  @@index([bossType, isActive, channel])
  @@map("boss_channels")
}
