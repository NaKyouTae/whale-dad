# ─── 서버 (apps/server) ───
NODE_ENV=development
PORT=20000

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:20001,http://127.0.0.1:20001

# ─────────────────────────────────────────────
# DB — 아래 둘 중 하나를 쓴다
# ─────────────────────────────────────────────

# (A) 로컬 개발용 PostgreSQL (pnpm db:up 으로 띄움) — 기본값
DATABASE_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad"
DIRECT_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad"
# prisma migrate 가 쓰는 임시 DB (아래 명령으로 미리 만들어 둔다)
#   docker compose exec -T postgres psql -U whaledad -d whaledad -c 'CREATE DATABASE whaledad_shadow'
SHADOW_DATABASE_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad_shadow"

# (B) Supabase PostgreSQL
#   Dashboard > Project Settings > Database > Connection string
#   DATABASE_URL : 앱 런타임용 (Transaction pooler, 6543 + pgbouncer=true)
#   DIRECT_URL   : prisma migrate 용 (Direct connection, 5432)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# 인증 (JWT) — httpOnly 쿠키로 내려간다
# 운영에서는 반드시 새로 생성할 것: openssl rand -hex 32
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# Supabase Client (Storage) — 선택
# 비워두면 Storage 기능만 꺼지고 서버는 정상 기동한다.
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용. 절대 프론트로 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=whale-dad
