# ─── 서버 (apps/server) ───
NODE_ENV=development
PORT=20000

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:20001,http://127.0.0.1:20001

# ─────────────────────────────────────────────
# DB — 아래 둘 중 하나를 쓴다
# ─────────────────────────────────────────────

# (A) 로컬 개발용 PostgreSQL (pnpm db:up 으로 띄움) — 기본값
DATABASE_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad"
DIRECT_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad"
# prisma migrate 가 쓰는 임시 DB (아래 명령으로 미리 만들어 둔다)
#   docker compose exec -T postgres psql -U whaledad -d whaledad -c 'CREATE DATABASE whaledad_shadow'
SHADOW_DATABASE_URL="postgresql://whaledad:whaledad@localhost:5432/whaledad_shadow"

# (B) Supabase PostgreSQL — Dashboard > Connect > Session pooler
#   런타임·마이그레이션 모두 Session pooler(5432) 하나로 충분하다.
#   - Direct connection(db.<ref>.supabase.co)은 IPv6 전용이라 Render 에서 붙지 않는다
#   - Transaction pooler(6543)를 굳이 쓸 이유가 없다. driver adapter 를 쓰면
#     ?pgbouncer= / ?connection_limit= 파라미터가 무시되고, 풀 크기는 DATABASE_POOL_MAX 로 정한다
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# 커넥션 풀 크기 (미지정 시 10)
# DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────
# 인증 (JWT) — httpOnly 쿠키로 내려간다
# 운영에서는 반드시 새로 생성할 것: openssl rand -hex 32
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# Supabase Client (Storage) — 선택
# 비워두면 Storage 기능만 꺼지고 서버는 정상 기동한다.
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용. 절대 프론트로 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=whale-dad
